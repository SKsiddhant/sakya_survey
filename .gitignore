# Project exclude paths
/.gradle/
/app/build/
/app/build/intermediates/javac/debug/compileDebugJavaWithJavac/classes/
/app/build/intermediates/javac/debugAndroidTest/compileDebugAndroidTestJavaWithJavac/classes/
/build/

# Local configuration and secrets: never commit these
local.properties
secrets.properties

# IDE and OS files
.idea/
*.iml
.DS_Store
/captures
.externalNativeBuild
.cxx

# Firebase config: download your own from the Firebase console (see google-services.json.example)
app/google-services.json

# Release signing material: never commit
*.jks
*.keystore
keystore.properties
