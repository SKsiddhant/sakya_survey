rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();

      // Users manage their own profile but can never grant themselves a role. isAdmin() trusts
      // this document's `role` field, so letting users write it meant anyone could become admin.
      // Make admins from the Firebase console (or the Admin SDK), which bypass these rules.
      allow create: if request.auth.uid == userId
                    && request.resource.data.get('role', 'user') == 'user';
      allow update: if request.auth.uid == userId
                    && request.resource.data.get('role', 'user') == resource.data.get('role', 'user');
      allow delete: if false;
    }

    // Surveys
    match /surveys/{surveyId} {
      // Anyone authenticated can read active surveys
      allow read: if isAuthenticated();

      // Only admins can create, update, or delete surveys
      allow create: if isAdmin() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isAdmin() && resource.data.creatorId == request.auth.uid;
    }

    // Broadcast notifications: admins send, signed-in users listen.
    // (The app reads and writes this collection but it had no rule, so both were denied.)
    match /broadcasts/{broadcastId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Responses
    match /responses/{responseId} {
      // Admins can read responses; respondents can read their own (History screen).
      allow read: if isAdmin()
                  || (isAuthenticated() && resource.data.respondentId == request.auth.uid);

      // Users can only create responses, cannot update or delete
      // Logic to ensure they don't spoof respondentId
      allow create: if isAuthenticated() &&
                    request.resource.data.respondentId == request.auth.uid &&
                    !exists(/databases/$(database)/documents/responses/$(responseId));

      allow update, delete: if false;
    }
  }
}
