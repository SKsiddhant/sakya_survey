rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId;
    }

    // Surveys
    match /surveys/{surveyId} {
      // Anyone authenticated can read active surveys
      allow read: if isAuthenticated();

      // Only admins can create, update, or delete surveys
      allow create: if isAdmin() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isAdmin() && resource.data.creatorId == request.auth.uid;
    }

    // Responses
    match /responses/{responseId} {
      // Admins can read responses to their surveys
      allow read: if isAdmin();

      // Users can only create responses, cannot update or delete
      // Logic to ensure they don't spoof respondentId
      allow create: if isAuthenticated() &&
                    request.resource.data.respondentId == request.auth.uid &&
                    !exists(/databases/$(database)/documents/responses/$(responseId));

      allow update, delete: if false;
    }
  }
}
